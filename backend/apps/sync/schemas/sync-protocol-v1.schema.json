{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ajuia-m/artjournal/schemas/sync-protocol-v1.schema.json",
  "title": "Art Journal sync command batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["operations"],
  "properties": {
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/operation"}
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "statePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lessonId",
        "studentId",
        "grade",
        "isPresent",
        "isExcusedAbsence",
        "homeworkPoints",
        "comment",
        "note"
      ],
      "properties": {
        "lessonId": {"$ref": "#/$defs/uuid"},
        "studentId": {"$ref": "#/$defs/uuid"},
        "grade": {
          "anyOf": [
            {"type": "integer", "minimum": 0, "maximum": 5},
            {"type": "null"}
          ]
        },
        "isPresent": {"type": "boolean"},
        "isExcusedAbsence": {"type": "boolean"},
        "homeworkPoints": {
          "anyOf": [
            {"type": "integer", "minimum": 0, "maximum": 101},
            {"type": "null"}
          ]
        },
        "comment": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "operationId",
        "clientId",
        "clientSequence",
        "schoolId",
        "entityType",
        "entityId",
        "action",
        "baseVersion",
        "dependsOn",
        "payload",
        "createdAt"
      ],
      "properties": {
        "protocolVersion": {"const": 1},
        "operationId": {"$ref": "#/$defs/uuid"},
        "clientId": {"$ref": "#/$defs/uuid"},
        "clientSequence": {"type": "integer", "minimum": 1},
        "schoolId": {"$ref": "#/$defs/uuid"},
        "entityType": {"const": "student_lesson_state"},
        "entityId": {"$ref": "#/$defs/uuid"},
        "action": {"enum": ["upsert", "delete"]},
        "baseVersion": {
          "anyOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/uuid"}
        },
        "payload": {"type": "object"},
        "createdAt": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"action": {"const": "upsert"}},
            "required": ["action"]
          },
          "then": {
            "properties": {"payload": {"$ref": "#/$defs/statePayload"}}
          }
        },
        {
          "if": {
            "properties": {"action": {"const": "delete"}},
            "required": ["action"]
          },
          "then": {
            "properties": {
              "baseVersion": {"type": "integer", "minimum": 1},
              "payload": {
                "type": "object",
                "maxProperties": 0
              }
            }
          }
        }
      ]
    }
  }
}
