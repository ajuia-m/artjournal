# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Django backend development settings.
# Replace DJANGO_SECRET_KEY outside local development.
DJANGO_SECRET_KEY=development-only-change-me
# Use a different long random value for signing JWT in production.
JWT_SIGNING_KEY=development-jwt-signing-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL settings used by Docker Compose and local backend commands.
POSTGRES_DB=artjournal
POSTGRES_USER=artjournal
POSTGRES_PASSWORD=artjournal
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
